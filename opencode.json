{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "local",
  "permission": {
    "*": "deny",
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow",
      "*.pem": "deny",
      "*.key": "deny"
    },
    "glob": "allow",
    "grep": "allow",
    "edit": "ask",
    "bash": "deny",
    "task": "deny",
    "external_directory": "deny"
  }
}
